# Server-only AI provider. Use any OpenAI-compatible chat completions API.
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
# Set to false when the provider does not support response_format json_object.
AI_JSON_MODE=true

# Server-only Supabase credentials. Do not prefix these with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google sign-in. Create a Web OAuth client and allow http://localhost:3000/api/auth/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional cookie signing secret. Falls back to SUPABASE_SERVICE_ROLE_KEY.
AUTH_SECRET=

# Public site URL used in shared-link previews. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional in-memory generation rate limit per IP.
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000
